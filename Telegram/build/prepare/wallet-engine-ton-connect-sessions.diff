+    reason = "HMAC-SHA512 accepts a key of any length"
+)]
+fn hmac_sha512(key: &[u8], parts: &[&[u8]]) -> Zeroizing<[u8; 64]> {
+    let mut mac =
+        Hmac::<Sha512>::new_from_slice(key).expect("HMAC-SHA512 accepts a key of any length");
+    for part in parts {
+        mac.update(part);
+    }
+    let mut output = mac.finalize().into_bytes();
+    let mut result = Zeroizing::new([0_u8; 64]);
+    result.copy_from_slice(output.as_slice());
+    output.as_mut_slice().zeroize();
+    result
+}
