+/// `sk = clamp(HMAC-SHA512(HMAC-SHA512(seed, label), A || nonce)[0..32])`.
+pub(crate) fn derive_ton_connect_session_secret(
+    seed: &[u8; 32],
+    dapp_client_id: &[u8; 32],
+    nonce: &[u8],
