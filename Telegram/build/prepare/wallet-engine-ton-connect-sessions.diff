+        let mut tampered = challenge;
+        tampered[CHALLENGE_LENGTH - 1] ^= 1;
+        assert!(matches!(
+            session.open_challenge(tampered),
+            Err(TonConnectSessionError::Failed { .. })
+        ));
+        Ok(())
