# TwidgetCore from ThirdParty/twidget (core/src), in two libraries.
# lib_widget_renderer_platform is its platform end with the wire and remote
# messages, PNG and filter code, what Telegram's painter and hosted client
# link: neither litehtml nor the renderer, as twidget's own twidget_wire and
# twidget_remote targets. lib_widget_renderer, for TelegramWidgetHelper, adds
# over lib_litehtml the renderer core twidget's platforms share, its end, CSS,
# computed style, compositor, canvas, animations and paint policy: it applies
# validated widget operations to a document laid out by twidget's litehtml
# fork, answers layout queries, runs animations, canvas, input and text
# selection, and records a display list the platform paints. Built as twidget's
# own twidget_core target is, in fork mode (TW_LITEHTML_TWIDGET) against
# lib_litehtml, the only litehtml we build; the per-platform backends are not
# compiled, our Qt backend replaces them.
# The profile's UA layer (tables.uaStylesheet of widget-sandbox's
# packages/core/profile.json) is generated at configure time into
# tw_ua_stylesheet.h, as twidget's own CMakeLists does.
# Consumers include its headers as "core/src/<name>.h".
# There is no packaged branch: no distribution ships these libraries.

set(widget_sandbox_root ${third_party_loc}/widget-sandbox)
set(widget_renderer_root ${third_party_loc}/twidget)
set(widget_renderer_loc ${widget_renderer_root}/core/src)

if (NOT EXISTS ${widget_renderer_loc}/renderer.cpp)
    message(FATAL_ERROR "twidget sources are missing, run 'git submodule update --init --recursive'.")
endif()

set(widget_renderer_gen ${CMAKE_CURRENT_BINARY_DIR}/widget_renderer_gen)
set(widget_profile_json ${widget_sandbox_root}/packages/core/profile.json)
if (NOT EXISTS ${widget_profile_json})
    message(FATAL_ERROR "widget-sandbox sources are missing, run 'git submodule update --init --recursive'.")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${widget_profile_json})
file(READ ${widget_profile_json} widget_profile)
string(JSON widget_ua_stylesheet GET "${widget_profile}" tables uaStylesheet)
file(WRITE ${widget_renderer_gen}/tw_ua_stylesheet.h.tmp
    "// Generated by Telegram/cmake/lib_widget_renderer.cmake from packages/core/profile.json (tables.uaStylesheet).\n"
    "#pragma once\n"
    "inline constexpr const char* TW_UA_STYLESHEET = R\"tw-ua(${widget_ua_stylesheet})tw-ua\";\n")
configure_file(
    ${widget_renderer_gen}/tw_ua_stylesheet.h.tmp
    ${widget_renderer_gen}/tw_ua_stylesheet.h
    COPYONLY)

# Silence third-party warnings. On MSVC the flags must ride an INTERFACE lib
# linked after common_options to land last and beat its /W4 /WX.
if (MSVC)
    add_library(lib_widget_renderer_warnings_off INTERFACE)
    target_compile_options(lib_widget_renderer_warnings_off
    INTERFACE
        /W0
        /WX-
    )
endif()

function(add_widget_renderer_platform target_name host_target)
    add_library(${target_name} STATIC)
    if (APPLE)
        init_standalone_target(${target_name} "(external)")
    else()
        init_target(${target_name} "(external)")
    endif()

    add_library(tdesktop::${target_name} ALIAS ${target_name})

    nice_target_sources(${target_name} ${widget_renderer_loc}
    PRIVATE
        backend.h
        canvas_ops.h
        display_list.h
        filters.cpp
        filters.h
        platform_end.cpp
        platform_end.h
        png.cpp
        png.h
        remote.cpp
        remote.h
        wire.cpp
        wire.h
    )

    target_include_directories(${target_name}
    PUBLIC
        ${widget_renderer_root}
        ${widget_sandbox_root}/packages/desktop/sandbox/include
    PRIVATE
        ${widget_renderer_loc}
    )

    target_link_libraries(${target_name}
    PUBLIC
        ${host_target}
    )
endfunction()

add_widget_renderer_platform(lib_widget_renderer_platform tdesktop::lib_widget_sandbox_host)
set(widget_renderer_targets lib_widget_renderer_platform lib_widget_renderer)
if (MSVC OR LINUX)
    add_widget_renderer_platform(lib_widget_renderer_platform_hardened tdesktop::lib_widget_sandbox_host_hardened)
    list(APPEND widget_renderer_targets lib_widget_renderer_platform_hardened)
    set(widget_helper_renderer_platform lib_widget_renderer_platform_hardened)
else()
    set(widget_helper_renderer_platform lib_widget_renderer_platform)
endif()

add_library(lib_widget_renderer STATIC)
if (APPLE)
    init_standalone_target(lib_widget_renderer "(external)")
else()
    init_target(lib_widget_renderer "(external)")
endif()

add_library(tdesktop::lib_widget_renderer ALIAS lib_widget_renderer)

nice_target_sources(lib_widget_renderer ${widget_renderer_loc}
PRIVATE
    animations.cpp
    animations.h
    canvas.cpp
    canvas.h
    compositor.cpp
    compositor.h
    computed_style.cpp
    computed_style.h
    css.cpp
    css.h
    encode.cpp
    paint_policy.cpp
    paint_policy.h
    renderer.cpp
    renderer.h
    renderer_end.cpp
    renderer_end.h
    text_widths.cpp
    text_widths.h
)

target_include_directories(lib_widget_renderer
PRIVATE
    ${widget_renderer_gen}
    ${widget_renderer_loc}
)

target_compile_definitions(lib_widget_renderer
PUBLIC
    TW_LITEHTML_TWIDGET
)

target_link_libraries(lib_widget_renderer
PUBLIC
    ${widget_helper_renderer_platform}
    tdesktop::lib_litehtml
)

foreach (target ${widget_renderer_targets})
    if (MSVC)
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
        target_link_libraries(${target} PRIVATE lib_widget_renderer_warnings_off)
    else()
        target_compile_options(${target} PRIVATE -w)
    endif()
endforeach()
