using "info/info.style";

infoTopBarColoredBack: IconButton(infoTopBarBack) {
	icon: icon {{ "info/info_back", groupCallMembersFg }};
	iconOver: icon {{ "info/info_back", groupCallMembersFg }};
	ripple: universalRippleAnimation;
}
