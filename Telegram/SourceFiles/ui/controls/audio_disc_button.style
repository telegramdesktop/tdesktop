using "ui/basic.style";
using "ui/widgets/widgets.style";

audioDiscSize: 48px;
audioDiscCoverSize: 30px;
audioDiscRing: 2px;
audioDiscRingFg: mediaviewControlFg;
audioDiscRingDuration: 120;
audioDiscIcon: icon {{ "photo_editor/widget_music", mediaviewPipControlsFg }};
audioDiscIconOver: icon {{ "photo_editor/widget_music", mediaviewPipControlsFgOver }};
