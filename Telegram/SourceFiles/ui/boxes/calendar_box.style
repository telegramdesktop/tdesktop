using "boxes/boxes.style";

calendarTitleFont: boxTitleFont;
calendarDaysFont: normalFont;
calendarDaysFontOver: semiboldFont;
calendarDaysFg: boxTitleAdditionalFg;
calendarScroll: ScrollArea(defaultSolidScroll) {
	deltat: 3px;
	deltab: 3px;
	round: 1px;
	width: 8px;
	deltax: 3px;
	hiding: 1000;
}
