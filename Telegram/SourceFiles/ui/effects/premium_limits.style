using "ui/widgets/widgets.style";

PremiumLimits {
	boxLabel: FlatLabel;
	nonPremiumBg: color;
	nonPremiumFg: color;
	gradientFromLeft: bool;
}
ComposePremiumRequired {
	label: FlatLabel;
	button: RoundButton;
	buttonSkip: pixels;
	buttonTop: pixels;
	position: point;
	icon: icon;
}
