		font: font(14px);
	}
}
walletRowDateLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(14px);
	}
}
walletRowSkip: 4px;
walletRowAmountMajorLabel: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(14px semibold);
	}
}
walletRowAmountMinorLabel: FlatLabel(walletRowAmountMajorLabel) {
}
walletRowAmountMinorSkip: 0px;
walletRowMarkSize: 15px;
walletRowIconMargin: margins(5px, 3px, 0px, 0px);
walletRowsHintHeight: 44px;
walletSendingRowOutset: 7px;
walletSendingRowAmountFont: font(19px semibold);
walletSendingRowTextMinWidth: 96px;
walletSendingRowDiamondSkip: 8px;
walletSendingRowClockSize: 14px;
walletSendingRowClockStroke: 1px;
walletSendingRowClockMinuteHand: 5px;
walletSendingRowClockHourHand: 4px;
walletSendingRowClockShift: 16px;
walletSendingRowClockCutout: 2px;
walletSendingRowGlareWidth: 168px;
walletSendingRowGlareStroke: 2px;
walletSendingRowEntranceShift: 13px;
walletSendingRowBurstOutset: 24px;
// Text left is walletRowPadding.left, so the row's text lines up with the
// transaction titles; iconLeft centres the 24px icon on the 46px avatar
// column at walletRowIconLeft (20 + (46 - 24) / 2). Right 50px is the same
// chevron allowance walletIslandRow uses for AddRowChevron.
walletProtectRowSkip: walletRowsTopSkip;
walletProtectRow: SettingsButton(settingsAttentionButtonWithIcon) {
	padding: margins(76px, 10px, 50px, 10px);
	iconLeft: 31px;
}
walletProtectRowIcon: icon{{ "menu/info", attentionButtonFg }};
