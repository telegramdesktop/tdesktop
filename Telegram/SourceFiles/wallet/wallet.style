walletReceiveAddressFont: font(14px semibold);
walletReceiveAddressTopSkip: 11px;
walletReceiveAddressLineSkip: -2px;
walletReceiveHintFont: font(13px);
walletReceiveHintTopSkip: 4px;
walletReceiveAboutLabel: FlatLabel(walletPhraseTextLabel) {
	minWidth: 20px;
	textFg: activeButtonFg;
}
walletReceiveAboutMargin: margins(24px, 12px, 24px, 0px);
walletReceiveBuyButton: RoundButton(defaultLightButton) {
	height: 42px;
	textTop: 12px;
	style: semiboldTextStyle;
}
walletReceiveBuyMargin: margins(16px, 16px, 16px, 12px);

walletBuySubsectionPadding: margins(22px, 19px, 22px, 10px);
walletBuySectionBottomSkip: 12px;
walletBuyRow: SettingsButton(settingsButtonNoIcon) {
	iconLeft: 22px;
}
walletBuyRowPadding: margins(62px, 6px, 50px, 8px);
walletBuyRowSkip: 2px;
walletBuyRowTitle: FlatLabel(defaultFlatLabel) {
	textFg: windowBoldFg;
	style: boxTextStyle;
}
walletBuyRowSubtitle: FlatLabel(defaultFlatLabel) {
	// Ui::FlatLabel builds its Ui::Text::String with a minimal resize width
	// of kQFixedMax when minWidth is zero, and Ui::Text::String::countSize
	// then clamps every measurement to that. A subtitle wider than this
	// column would be measured as one line and painted wrapped, so every
	// line but the first would be clipped away. Keep this at or below
	// boxWideWidth minus the horizontal walletBuyRowPadding.
	minWidth: 200px;
	textFg: windowSubTextFg;
	style: boxTextStyle;
}
walletBuyIconSize: size(24px, 24px);
walletBuyBankCardIcon: icon {
	{ walletBuyIconSize, transparent },
	{ "wallet/bank_card", settingsIconFg, point(4px, 7px) },
};
walletBuyCryptoIcon: icon {
	{ walletBuyIconSize, transparent },
	{ "wallet/cryptocurrency", settingsIconFg, point(6px, 4px) },
};
walletBuyP2pIcon: icon {
	{ walletBuyIconSize, transparent },
	{ "wallet/p2p_market", settingsIconFg, point(3px, 3px) },
};
walletBuyWaltIcon: icon {
	{ walletBuyIconSize, transparent },
	{ "wallet/walt", settingsIconFg, point(2px, 2px) },
};

walletHowLottieSize: 52px;
walletHowLottieMargin: margins(24px, 24px, 24px, 12px);
walletHowSubtitleLabel: FlatLabel(walletPhraseTextLabel) {
	minWidth: 20px;
}
walletHowSubtitleMargin: margins(24px, 8px, 24px, 14px);
walletFirstSendIcon: icon{{ "menu/send", windowBoldFg }};
walletFirstTradeIcon: icon{{ "wallet/trade-24x24", windowBoldFg }};
walletFirstStoreIcon: icon{{ "menu/wallet-24x24", windowBoldFg }};
walletFirstAttachEmoji: IconEmoji {
	icon: icon{{ "poll/general/outline_poll_attach-16x16", windowSubTextFg }};
	padding: margins(1px, 1px, 1px, 0px);
}
walletFirstMenuEmoji: IconEmoji(walletFirstAttachEmoji) {
	icon: icon{{ "wallet/menu_bars-16x16", windowSubTextFg }};
}

// Fits walletSendButton; the layer insets both edge buttons by right().
walletConnectBox: Box(defaultBox) {
	buttonPadding: margins(24px, 12px, 24px, 12px);
	buttonHeight: 40px;
}
walletConnectBack: IconButton(boxTitleClose) {
	icon: icon {{ "box_button_back", boxTitleCloseFg }};
	iconOver: icon {{ "box_button_back", boxTitleCloseFgOver }};
}
walletConnectIconSize: 72px;
walletConnectIconMargin: margins(24px, 24px, 24px, 12px);
walletConnectIconPlaceholder: icon{{ "menu/link", windowSubTextFg }};
// A zero minWidth would make Ui::Text::String measure the title as one line.
walletConnectTitleLabel: FlatLabel(walletPhraseTitleLabel) {
	minWidth: 200px;
}
walletConnectTitleMargin: margins(24px, 0px, 24px, 4px);
walletConnectDomainLabel: FlatLabel(boxLabel) {
	align: align(top);
	textFg: windowSubTextFg;
}
walletConnectDomainMargin: margins(24px, 0px, 24px, 14px);
walletConnectTextLabel: FlatLabel(boxLabel) {
	align: align(top);
}
walletConnectTextMargin: margins(24px, 0px, 24px, 16px);
walletConnectCardMargin: margins(0px, 0px, 0px, 14px);
walletConnectCaptionLabel: FlatLabel(walletCommentCaptionLabel) {
	align: align(top);
}
walletConnectCaptionMargin: margins(24px, 0px, 24px, 16px);
walletConnectSignDataLabel: FlatLabel(walletCommentLabel) {
	palette: TextPalette(defaultTextPalette) {
		monoFg: windowFg;
	}
}
walletConnectSignFieldLabel: FlatLabel(walletConnectSignDataLabel) {
	palette: TextPalette(defaultTextPalette) {
		monoFg: windowFg;
		linkFg: windowSubTextFg;
	}
}
walletConnectSignFieldIndent: 16px;
walletConnectSignCaptionMargin: margins(24px, 8px, 24px, 16px);
walletConnectActionIconLeft: 13px;
walletConnectActionPadding: margins(71px, 11px, 20px, 11px);
walletConnectErrorLabel: FlatLabel(walletCommentErrorLabel) {
	align: align(top);
}
// defaultLightButton's textBg is windowBg, so Cancel would have no fill.
walletConnectCancelButton: RoundButton(walletSendButton) {
	textFg: windowActiveTextFg;
	textFgOver: windowActiveTextFg;
	textBg: windowBgOver;
	textBgOver: windowBgOver;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgRipple;
	}
}
walletAppsNameLabel: FlatLabel(walletRowTitleLabel) {
	minWidth: 20px;
}
walletAppsDomainLabel: FlatLabel(walletRowSubtitleLabel) {
	minWidth: 20px;
}
walletAppsDateLabel: FlatLabel(walletRowDateLabel) {
	minWidth: 20px;
}

walletIntroTooltip: ImportantTooltip(defaultImportantTooltip) {
	padding: margins(8px, 3px, 8px, 5px);
	margin: margins(4px, 4px, 4px, 8px);
}
walletIntroTooltipFont: font(11px semibold);

walletCurrencyRowHeight: 36px;
walletCurrencyRowPadding: margins(24px, 9px, 24px, 0px);
walletCurrencyRowCodeFont: semiboldFont;
walletCurrencyRowCodeFg: windowBoldFg;
walletCurrencyRowNameFg: windowSubTextFg;
walletCurrencyRowNameSkip: 8px;
walletCurrencyListSkip: 12px;
walletCurrencyCheckIcon: icon{{ "player/player_check", windowActiveTextFg }};

walletProtectionAttentionCheckbox: Checkbox(defaultBoxCheckbox) {
	textFg: attentionButtonFg;
	textFgActive: attentionButtonFg;
}
walletProtectionAboutLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 200px;
	textFg: windowSubTextFg;
}
walletProtectionIntroMargin: margins(22px, 4px, 22px, 4px);
walletProtectionRowSkip: 12px;
walletProtectionAboutMargin: margins(34px, 0px, 22px, 0px);
walletProtectionChangeMargin: margins(34px, 6px, 22px, 0px);
walletProtectionCreateFieldMargin: margins(22px, 12px, 22px, 0px);
walletProtectionMeterMargin: margins(22px, 8px, 22px, 0px);
