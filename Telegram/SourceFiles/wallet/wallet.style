using "ui/basic.style";
using "ui/layers/layers.style";
using "ui/widgets/widgets.style";

walletMenuIcon: icon{{ "menu/wallet-24x24", menuIconColor }};

walletTopBarTitleLabel: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	textFg: dialogsNameFg;
}

walletContentWidth: 332px;
walletCardHeight: 208px;
walletCardRadius: 16px;
walletCardTopSkip: 12px;
walletCardContentLeft: 22px;
walletCardContentSkip: 8px;
walletCardSecondaryOpacity: 0.65;
walletCardBalanceTop: 74px;
walletCardBalanceMajorLabel: FlatLabel(defaultFlatLabel) {
	maxHeight: 52px;
	textFg: premiumButtonFg;
	style: TextStyle(defaultTextStyle) {
		font: font(26px semibold);
	}
}
walletCardIconMargin: margins(0px, 4px, 2px, 0px);
walletCardBalanceMinorLabel: FlatLabel(walletCardBalanceMajorLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(18px semibold);
	}
}
walletCardBalanceMinorSkip: 8px;
walletCardTickerLabel: FlatLabel(walletCardBalanceMajorLabel) {
}
walletCardTickerSkip: 7px;
walletCardNameFont: font(13px semibold);
walletCardNameBottom: 18px;
walletCardAddressFont: font(10px semibold);
walletCardAddressSkip: 17px;
walletCardAddressRight: 8px;
walletCardQrSize: 46px;
walletCardQrRadius: 10px;
walletCardQrRight: 52px;
walletCardQrIcon: icon{{ "menu/qr_code", premiumButtonFg }};
walletCardQrBgOpacity: 0.2;

walletSendButton: RoundButton(defaultActiveButton) {
	height: 40px;
	textTop: 11px;
	radius: 20px;
}
walletSendButtonMargin: margins(0px, 12px, 0px, 0px);
walletButtonsSkip: 8px;

walletAboutTopSkip: 24px;
walletAboutPadding: margins(60px, 0px, 24px, 0px);
walletAboutTitleLabel: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
}
walletAboutTextLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 248px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
walletAboutTitleSkip: 3px;
walletAboutIconSkip: 3px;
walletAboutRowSkip: 12px;
walletAboutInstantIcon: icon{{ "menu/boosts", windowActiveTextFg }};
walletAboutFeesIcon: icon{{ "sponsored/revenue_split", windowActiveTextFg }};
walletAboutChainIcon: icon{{ "payments/ton_emoji-24x24", windowActiveTextFg }};

walletRowsTopSkip: 24px;
walletRowPadding: margins(68px, 6px, 24px, 6px);
walletRowIconSize: 46px;
walletRowIconLeft: 12px;
walletRowIconIn: icon{{ "calls/call_arrow_in", activeButtonFg }};
walletRowIconOut: icon{{ "calls/call_arrow_out", activeButtonFg }};
walletRowTitleLabel: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
}
walletRowSubtitleLabel: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
walletRowDateLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
walletRowSkip: 3px;
walletRowAmountMajorLabel: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(14px semibold);
	}
}
walletRowAmountMinorLabel: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px semibold);
	}
}
walletRowAmountMinorSkip: 2px;
walletRowIconMargin: margins(3px, 0px, 0px, 0px);

walletDetailsAmountMajorLabel: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(26px semibold);
	}
}
walletDetailsAmountMinorLabel: FlatLabel(walletDetailsAmountMajorLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(18px semibold);
	}
}
walletDetailsAmountMinorSkip: 8px;
walletDetailsIconMargin: margins(6px, 0px, 0px, 0px);
walletDetailsAmountTopSkip: 16px;
walletDetailsAmountBottomSkip: 24px;
walletDetailsAddressLabel: FlatLabel(defaultTableValue) {
	minWidth: 128px;
	maxHeight: 100px;
}

walletSendAddressField: InputField(defaultInputField) {
	textMargins: margins(0px, 10px, 76px, 2px);
	placeholderFg: placeholderFg;
	placeholderFgActive: placeholderFgActive;
	placeholderFgError: placeholderFgActive;
	placeholderScale: 0.;
	placeholderFont: boxTextFont;
	heightMin: 36px;
}
walletSendPaste: RoundButton(defaultTableSmallButton) {
	width: -24px;
	height: 26px;
	radius: 13px;
	textTop: 4px;
	style: semiboldTextStyle;
}
walletSendPasteTop: 5px;
walletSendErrorLabel: FlatLabel(defaultFlatLabel) {
	textFg: attentionButtonFg;
}
walletSendBalanceLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
}
walletSendRowSkip: 12px;
walletSendAmountTopSkip: 16px;

walletBannerTopSkip: 12px;
walletPhraseTitleLabel: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(17px semibold);
	}
	align: align(top);
}
walletPhraseTitleMargin: margins(24px, 48px, 24px, 0px);
walletPhraseTextLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 256px;
	align: align(top);
}
walletPhraseTextMargin: margins(24px, 8px, 24px, 8px);
walletPhraseWarnPadding: margins(60px, 0px, 24px, 0px);
walletPhraseWarnLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 248px;
}
walletPhraseWarnIconSkip: 3px;
walletPhraseWarnRowSkip: 12px;
walletPhraseWarnShareIcon: icon{{ "menu/stealth", windowActiveTextFg }};
walletPhraseWarnStealIcon: icon{{ "menu/report", windowActiveTextFg }};
walletPhraseWarnSupportIcon: icon{{ "menu/lock", windowActiveTextFg }};
walletPhraseGridPadding: margins(40px, 16px, 40px, 8px);
walletPhraseColumnSkip: 16px;
walletPhraseRowSkip: 8px;
walletPhraseNumberWidth: 24px;
walletPhraseNumberLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
}
walletPhraseWordLabel: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
}
walletPasscodeFieldMargin: margins(22px, 16px, 22px, 0px);
walletPasscodeErrorMargin: margins(22px, 8px, 22px, 8px);
walletReplaceButtonMargin: margins(22px, 12px, 22px, 0px);
walletReplaceTitleLabel: FlatLabel(boxTitle) {
	minWidth: 120px;
	maxHeight: 0px;
}
walletReplaceTitleMargin: margins(22px, 16px, 22px, 4px);
walletImportToggleMargin: margins(22px, 8px, 22px, 4px);
walletImportField: InputField(walletSendAddressField) {
	textMargins: margins(34px, 10px, 76px, 2px);
}
walletImportFieldMargin: margins(22px, 4px, 22px, 4px);
walletImportNumberLeft: 10px;
walletImportNumberTop: 10px;
walletImportClear: CrossButton {
	width: 22px;
	height: 22px;

	cross: CrossAnimation {
		size: 22px;
		skip: 6px;
		stroke: 1.5;
		minScale: 0.3;
	}
	crossFg: boxTitleCloseFg;
	crossFgOver: boxTitleCloseFgOver;
	crossPosition: point(0px, 0px);

	duration: 150;
	loadingPeriod: 1000;
	ripple: defaultRippleAnimationBgOver;
}
walletImportClearPosition: point(11px, 7px);
walletImportErrorLabel: FlatLabel(walletSendErrorLabel) {
	minWidth: 120px;
}
walletImportSuggestionsSkip: 2px;
walletImportSuggestionsPadding: margins(4px, 4px, 4px, 4px);
walletImportSuggestionRowHeight: 28px;
walletImportSuggestionRowPadding: margins(8px, 0px, 8px, 0px);

walletReceivePanelMargin: margins(24px, 48px, 24px, 0px);
walletReceivePanelRadius: 16px;
walletReceivePanelPadding: margins(16px, 16px, 16px, 16px);
walletReceiveQrSize: 260px;
walletReceiveActionSkip: 16px;
walletReceiveAddressFont: font(26px semibold);
walletReceiveAddressLineSkip: 4px;
walletReceiveCopiedTopSkip: 16px;
walletReceiveCopiedSkip: 6px;
walletReceiveCopiedIcon: icon{{ "toast/check-16x16", windowActiveTextFg }};
walletReceiveAboutLabel: FlatLabel(walletPhraseTextLabel) {
	textFg: windowSubTextFg;
}
walletReceiveAboutMargin: margins(24px, 16px, 24px, 24px);

walletHowLogoIcon: icon{{ "payments/ton_emoji-48x48", windowFgActive }};
walletHowLogoPadding: margins(8px, 8px, 8px, 8px);
walletHowLogoMargin: margins(24px, 48px, 24px, 10px);

walletIntroEmoji: IconEmoji {
	icon: icon{{ "payments/ton_emoji-18x18", windowActiveTextFg }};
	padding: margins(0px, 1px, 4px, 0px);
	useIconColor: true;
}
walletIntroTooltipMaxWidth: 236px;
walletIntroTooltipSkip: 8px;
