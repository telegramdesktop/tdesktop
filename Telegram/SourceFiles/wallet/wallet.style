	size: size(56px, 56px);
	color: windowSubTextFg;
	thickness: 4px;
}
walletKeysRowLoading: InfiniteRadialAnimation(startGiveawayButtonLoading) {
	color: windowSubTextFg;
}
walletBusyBoxLoading: InfiniteRadialAnimation(walletListsLoading) {
