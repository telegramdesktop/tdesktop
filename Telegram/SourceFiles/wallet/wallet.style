using "ui/basic.style";
using "ui/chat/chat.style";
using "ui/layers/layers.style";
using "ui/widgets/widgets.style";
using "info/channel_statistics/boosts/giveaway/giveaway.style";
using "settings/settings.style";

walletMenuIcon: icon{{ "menu/wallet-24x24", menuIconColor }};
walletMenuCurrencyIcon: icon{{ "menu/ip_address", menuIconColor }};

walletPanelSize: size(392px, 620px);
walletCardHeight: 190px;
walletCardMargin: margins(40px, 0px, 40px, 0px);
walletCardRadius: 16px;
walletCardSoftness: 55px;
walletCardFieldStep: 4px;
walletCardTopSkip: 6px;
walletCardContentLeft: 20px;
walletCardContentSkip: 8px;
walletCardSecondaryOpacity: 0.6;
walletCardBalanceTop: 70px;
walletCardBalanceMajorLabel: FlatLabel(defaultFlatLabel) {
	maxHeight: 44px;
	textFg: activeButtonFg;
	style: TextStyle(defaultTextStyle) {
		font: font(22px semibold);
	}
}
walletCardMarkSize: 20px;
walletCardIconMargin: margins(0px, 1px, 6px, 0px);
walletCardBalanceMinorLabel: FlatLabel(walletCardBalanceMajorLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(16px semibold);
	}
}
walletCardTickerSkip: 7px;
walletCardFiatLabel: FlatLabel(defaultFlatLabel) {
	textFg: activeButtonFg;
	style: TextStyle(defaultTextStyle) {
		font: font(14px semibold);
	}
}
walletCardFiatTop: 98px;
walletCardFoldTopScale: 0.80;
walletCardFoldBottomScale: 0.92;
walletCardFoldFadePower: 4.0;
walletCardAngleReach: 320px;
walletTitleFoldScale: 0.95;
walletBalanceHeaderMajorFont: font(15px semibold);
walletBalanceHeaderFiatFont: font(12px semibold);
walletBalanceHeaderLineSkip: 2px;
walletCardNameFont: font(13px semibold);
walletCardNameBottom: 17px;
walletCardAddressFont: font(9px semibold);
walletCardAddressSkip: 13px;
walletCardAddressRight: 14px;
walletCardQrSize: size(46px, 36px);
walletCardQrRadius: 10px;
walletCardQrRight: 42px;
walletCardQrTop: 72px;
walletCardQrIcon: icon{{ "menu/qr_code", windowSubTextFg }};
walletCardInfoIcon: icon{{ "menu/info", windowSubTextFg }};
walletChatCardMarkTop: 29px;
walletChatCardMarkSize: 42px;
// The animation paints over its layout slot, centred on it, so rows stay put.
walletChatCardMarkPaintSize: 63px;
// Lifts the larger diamond enough to keep today's gap above the amount.
walletChatCardMarkRaise: 8px;
walletChatCardGlareWidth: 90px;
walletChatCardGlareStroke: 2px;
walletChatCardClockSize: 12px;
walletChatCardClockStroke: 1px;
walletChatCardClockMinuteHand: 4px;
walletChatCardClockHourHand: 3px;
// The settled word rises into its ribbon from this far below its rest.
walletChatCardRevealWordShift: 8px;
walletChatCardAmountSkip: 3px;
walletChatCardNameSkip: 15px;
walletChatCardAddressSkip: 5px;
walletChatCardBottom: 11px;
// Halves the capture's measured 12px gap: chatUniqueGiftBorder + 2 = 6.
walletChatCardCommentSkip: 2px;

walletSendButton: RoundButton(defaultActiveButton) {
	height: 40px;
	textTop: 11px;
	fullRadius: true;
}
// Sides match walletRowIconLeft, the gap matches the card-to-buttons skip.
walletSendButtonMargin: margins(20px, 12px, 20px, 0px);
walletButtonsSkip: 12px;
walletIslandMargin: margins(20px, 0px, 20px, 0px);
walletHeaderBottomSkip: 12px;
// Left 22px and the vertical 10/8 are settingsButtonNoIcon's own values, so
// the row stays 38px tall. Right 50px is walletBuyRowPadding's existing
// allowance for the same st::backButton chevron - SettingsButton::paintText
// elides at width - padding.left - padding.right, so 22px would let the
// text run under the arrow. Both backgrounds are transparent because the
// island paints the pill behind every entry.
walletIslandRow: SettingsButton(settingsButtonNoIcon) {
	textBg: transparent;
	textBgOver: transparent;
	padding: margins(22px, 10px, 50px, 8px);
}
// The Gram Earnings entry carries its sentence in a FlatLabel, so its width
// limit is a WRAP width, not walletIslandRow's conservative 50px elision
// allowance: AddRowChevron's st::backButton is 40px wide, inset 5px by
// settingsPremiumArrowShift and centring a 16px icon, so the chevron's icon
// box begins 33px from the row's right edge. minWidth is the wrap
// measurement's own floor - a zero one makes Ui::Text::String measure every
// string as one line, which walletBuyRowSubtitle below explains in full.
walletIslandRowLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 80px;
	style: boxTextStyle;
	textFg: windowBoldFg;
}
walletIslandLabelRightSkip: 33px;
walletInfoIslandShadow: BoxShadow {
	blurRadius: 3px;
	offset: point(0px, 1px);
	opacity: 0.09;
}

walletAboutTopSkip: 24px;
walletAboutPadding: margins(90px, 0px, 54px, 0px);
walletAboutIconLeft: 48px;
walletAboutTitleLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowBoldFg;
	style: TextStyle(defaultTextStyle) {
		font: font(15px semibold);
	}
}
walletAboutTextLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 248px;
	textFg: windowSubTextFg;
}
walletAboutTitleSkip: 3px;
walletAboutRowSkip: 20px;
walletAboutInstantIcon: icon{{ "menu/send_instantly-24x24", windowBoldFg }};
walletAboutFeesIcon: icon{{ "menu/no_fees-24x24", windowBoldFg }};
walletAboutChainIcon: icon{{ "menu/blockchain_verified-24x24", windowBoldFg }};

walletRowsTopSkip: 16px;
walletAboutBottomSkip: walletRowsTopSkip;
walletRowPadding: margins(76px, 6px, 20px, 6px);
walletRowIconSize: 46px;
walletRowIconLeft: 20px;
walletRowArrowIn: icon{{ "wallet/incoming_arrow", historyPeerUserpicFg }};
walletRowArrowOut: icon{{ "wallet/outgoing_arrow", historyPeerUserpicFg }};
walletRowGearIcon: icon{{ "wallet/gear", historyPeerUserpicFg }};
walletRowKeyIcon: icon{{ "settings/key", historyPeerUserpicFg }};
walletRowTitleLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowBoldFg;
