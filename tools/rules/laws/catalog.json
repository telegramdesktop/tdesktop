{
  "version": 1,
  "layout": {
    "columns": 78,
    "tab_width": 8,
    "closing_parenthesis_decisions": "0000000000001112"
  },
  "rules": [
    {
      "id": "layout.line-width",
      "scope": "Added physical lines of C++ sources, measured in Unicode code points.",
      "exceptions": "The line terminator is excluded. Tabs advance to the next tab stop.",
      "diagnostic": "Report an added line exceeding the column limit.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "^\\d+ columns \\(limit \\d+, tab width \\d+\\)\\. Wrap the line\\.$",
          "inputs": "Source bytes and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "call.closing-parenthesis",
      "scope": "Written C++ calls with a detached closing parenthesis, including a sole inline argument followed by a split call tail.",
      "exceptions": "Empty calls, same-line closers, syntax errors, and continued expressions after a detached closer when the final argument already starts on a new line.",
      "diagnostic": "Report the closer when a staged line intersects the span emitted by the executable specification.",
      "fix": "Use the byte edits emitted by the specification for an attachment or a safe wrap of a sole inline argument.",
      "implementations": {
        "python": {
          "match": "^Keep the closing parenthesis with the final argument\\.$",
          "inputs": "C++ source bytes, the shared Tree-sitter grammar and layout settings, and staged line ranges.",
          "modes": [
            "staged"
          ]
        },
        "clang": {
          "match": "tdesktop-closing-parenthesis",
          "inputs": "Original C++ source bytes from Clang's buffer and line filters. The shared specification reads the same grammar and layout settings."
        }
      }
    },
    {
      "id": "call.member-wrap",
      "scope": "A split arrow method on a simple receiver, or a split dot method on a simple receiver in a ternary branch.",
      "exceptions": "Comments and unsupported argument layouts can prevent reflow.",
      "diagnostic": "Report the split between the receiver and the method.",
      "fix": "Keep the method on the receiver line and wrap a short argument with its closer.",
      "implementations": {
        "python": {
          "match": "^Keep the method name with its receiver and wrap the arguments\\.$",
          "inputs": "Tree-sitter member expression, argument and changed lines.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "call.nested-wrap",
      "scope": "A multiline nested argument starting on the outer call opening line.",
      "exceptions": "Inline multiline lambdas, sole braced arguments, and unsafe token boundaries.",
      "diagnostic": "Report the opening of the outer call.",
      "fix": "Move the first argument onto the next line when the reflow fits.",
      "implementations": {
        "clang": {
          "match": "tdesktop-nested-multiline-call",
          "inputs": "Clang expressions and source tokens from a compile command."
        }
      }
    },
    {
      "id": "ternary.branch-indent",
      "scope": "Leading ? and : after an unparenthesized multiline built-in logical condition.",
      "exceptions": "Macro locations, crossed directives and inline markers.",
      "diagnostic": "Report each misindented branch marker. Changed logical continuations also expose the markers.",
      "fix": "Use one tab past the first logical continuation when the resulting line fits.",
      "implementations": {
        "clang": {
          "match": "tdesktop-ternary-branch-indent",
          "inputs": "Clang conditional and built-in binary operators from a compile command."
        }
      }
    },
    {
      "id": "call.argument-lines",
      "scope": "Multiline calls with multiple arguments that intersect added lines.",
      "exceptions": "Certain inline visitor lambdas, inline rpl::on_next handlers with a lifetime, and two-argument calls with a non-lambda first argument and a second lambda whose opening brace fits on the call line.",
      "diagnostic": "Report the first packed argument. A later argument starts after the previous argument ends.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Put each argument of the multiline call on its own line after the opening parenthesis\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "lambda.sole-parameter",
      "scope": "A lambda with a sole parameter split from its capture.",
      "exceptions": "Overlong joins, comments, and unsupported or preprocessed parameter syntax.",
      "diagnostic": "Report the start of the split signature.",
      "fix": "Join the parameter with the capture when the resulting line fits.",
      "implementations": {
        "python": {
          "match": "Keep the sole lambda parameter on the same line as the capture\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "lambda.short-body",
      "scope": "A multiline lambda body with one eligible statement.",
      "exceptions": "Compound statements, comments, long lines, and bodies with multiple statements.",
      "diagnostic": "Report the start of the multiline lambda layout.",
      "fix": "Join the body and any compatible split signature if the result fits.",
      "implementations": {
        "python": {
          "match": "Keep the short lambda body on one line\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "rpl.short-stage",
      "scope": "An empty producer call followed by an RPL stage with one argument on the next line.",
      "exceptions": "Non-RPL stages, nonempty producers, comments, and stages that cannot fit on the continuation.",
      "diagnostic": "Report the producer line.",
      "fix": "Wrap before the producer's closing parenthesis and join the short stage.",
      "implementations": {
        "python": {
          "match": "Wrap before the producer closing parenthesis and keep the short RPL stage together\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "rpl.pipe-placement",
      "scope": "A leading pipe that separates consecutive RPL stages.",
      "exceptions": "Non-RPL operators and supported inline or nested pipeline forms.",
      "diagnostic": "Report the leading pipe.",
      "fix": "Rewrap the preceding stage so the pipe follows its closing parenthesis when the edit fits.",
      "implementations": {
        "python": {
          "match": "Keep the RPL pipe with the closing parenthesis of the preceding stage\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "expression.sum-terms",
      "scope": "A multiline binary addition or subtraction chain.",
      "exceptions": "Single-line chains and unary operators.",
      "diagnostic": "Report an operator that shares the left term's line or is separated from its right term.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Start each continuation term on its own line with \\+ or \\-\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "expression.logical-terms",
      "scope": "A multiline logical chain with a changed operand boundary.",
      "exceptions": "Single-line and independently parenthesized chains, and intervening comments or directives before an operand.",
      "diagnostic": "Report a packed or detached logical operator.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Start the continuation with (?:&&|\\|\\|) and its right operand\\.",
          "inputs": "Tree-sitter nodes, physical lines, and added lines from the Git diff.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "api.standard-library-replacement",
      "scope": "Configured forbidden Qt function spellings in staged C++ or edit payloads.",
      "exceptions": "Comments, string and character literals, and identifiers with a matching substring.",
      "diagnostic": "Report the configured replacement from .clang-tidy.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "\\w+ is banned (?:in this repository -- write|-- write) .+ instead\\.",
          "inputs": "Source bytes with comments and literals masked. Read CustomFunctions from .clang-tidy.",
          "modes": [
            "staged",
            "edit"
          ]
        }
      }
    },
    {
      "id": "comment.single-line",
      "scope": "New multiline comment blocks in staged C++ or edit payloads.",
      "exceptions": "License blocks, blocks carrying a reference URL, moved comments, and test harness files.",
      "diagnostic": "Report a multiline comment block.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "(?:\\d+-line comment: )?a comment is one line; longer only to carry a reference URL\\.",
          "inputs": "Comment blocks, added lines and removed comment text, or edit payload text.",
          "modes": [
            "staged",
            "edit"
          ]
        }
      }
    },
    {
      "id": "comment.commit-budget",
      "scope": "New single-line comments across staged C++ files.",
      "exceptions": "Edit payloads, moved comments, license blocks, test harness files, and labels on directives or closing braces.",
      "diagnostic": "Report the staged comment count when it exceeds two.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "this commit adds \\d+ comment lines; \\d+ is the budget\\.",
          "inputs": "Comment blocks, added lines and removed comment text, or edit payload text.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "git.hook-subject-prefix",
      "scope": "Commit subjects for staged changes in tools/rules or tools/clangtidy/compile_db.py.",
      "exceptions": "Commits with no staged changes in the hook paths.",
      "diagnostic": "Require the exact Git hook prefix followed by a space.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "commit\\-msg: subject must start with \\[git\\-hook\\] followed by a space when the commit changes Git hook files\\.",
          "inputs": "Commit message bytes and staged paths.",
          "modes": [
            "commit-msg"
          ]
        }
      }
    },
    {
      "id": "constructor.parameter-indent",
      "scope": "Constructor definitions with a written initializer list.",
      "exceptions": "Implicit constructors, template instantiations, macro locations, and inline parameters.",
      "diagnostic": "Report a continuation parameter with the wrong indentation.",
      "fix": "Place the parameter one tab past the declaration indentation.",
      "implementations": {
        "clang": {
          "match": "tdesktop-constructor-param-indent",
          "inputs": "Clang constructor and parameter type locations."
        }
      }
    },
    {
      "id": "function.empty-parameter-indent",
      "scope": "Function definitions with an empty compound body, including comment-only bodies.",
      "exceptions": "Constructors, lambdas, declarations, macro bodies, and bodies containing a statement.",
      "diagnostic": "Report a misindented continuation parameter.",
      "fix": "Place the parameter one tab past the declaration indentation.",
      "implementations": {
        "clang": {
          "match": "tdesktop-empty-function-param-indent",
          "inputs": "Clang function, body tokens, and parameter locations."
        }
      }
    },
    {
      "id": "field.basic-initializer",
      "scope": "Basic scalar or pointer fields that may be left uninitialized by a constructor.",
      "exceptions": "Existing defaults, initialized fields, unions, and unsupported field types.",
      "diagnostic": "Report an uninitialized field.",
      "fix": "Insert the appropriate default after the name. Bitfields, function pointers, and macros are diagnostic only.",
      "implementations": {
        "clang": {
          "match": "tdesktop-init-basic-field",
          "inputs": "Clang field type, record, constructors, and member initializers."
        }
      },
      "fix_kind": "source-rewrite"
    },
    {
      "id": "lambda.argument-parameter-indent",
      "scope": "Multiline parameters in a lambda argument whose capture starts its own line.",
      "exceptions": "Local lambdas, inline captures, macro locations, and inline parameters.",
      "diagnostic": "Report a misindented parameter.",
      "fix": "Place the parameter one tab past the capture indentation.",
      "implementations": {
        "clang": {
          "match": "tdesktop-lambda-argument-param-indent",
          "inputs": "Clang lambda argument and parameter locations."
        }
      }
    },
    {
      "id": "declaration.local-auto",
      "scope": "Supported local value declarations that can use auto with an equivalent initializer.",
      "exceptions": "Pointers, references, arrays, macros, commented declarations, and declaration types requiring an explicit spelling.",
      "diagnostic": "Report a local declaration that can switch to auto.",
      "fix": "Rewrite the declaration with auto and preserve the declared type and initialization.",
      "implementations": {
        "clang": {
          "match": "tdesktop-local-type-auto",
          "inputs": "Clang declaration types, initializers, configured type sets, and source spelling."
        }
      },
      "fix_kind": "source-rewrite"
    },
    {
      "id": "expression.logical-group-indent",
      "scope": "Multiline logical terms inside a parenthesized operand of an outer logical continuation.",
      "exceptions": "Standalone groups, unrelated parenthesized expressions, and macros.",
      "diagnostic": "Report a misindented inner operator.",
      "fix": "Indent its line one tab past the group opener when it fits.",
      "implementations": {
        "clang": {
          "match": "tdesktop-logical-group-indent",
          "inputs": "Clang logical and parenthesized operators with source locations."
        }
      }
    },
    {
      "id": "member.access-line",
      "scope": "A member data access broken before its dot or arrow.",
      "exceptions": "Method calls, callable fields followed by parentheses, designated initializers, and macro locations.",
      "diagnostic": "Report the access operator.",
      "fix": "No automatic edit.",
      "implementations": {
        "clang": {
          "match": "tdesktop-member-access-line",
          "inputs": "Clang member declaration and base-expression source locations."
        }
      }
    },
    {
      "id": "attribute.repeated-nodiscard",
      "scope": "An out-of-line method definition that repeats nodiscard from a declaration.",
      "exceptions": "Inline definitions, free functions, and definitions whose declaration lacks the attribute.",
      "diagnostic": "Report the repeated attribute on the method definition.",
      "fix": "Remove a standalone attribute or its whole line. Compound attribute lists are diagnostic only.",
      "implementations": {
        "clang": {
          "match": "tdesktop-nodiscard-on-definition",
          "inputs": "Clang method redeclarations, attributes, and source tokens."
        }
      },
      "fix_kind": "source-rewrite"
    },
    {
      "id": "function.orphaned-return-type",
      "scope": "A qualified, template, or pointer leading return type immediately above a function name.",
      "exceptions": "Trailing return types, simple leading types, blank gaps, special member declarations, and macros.",
      "diagnostic": "Report the function name and suggest trailing return syntax.",
      "fix": "No automatic edit.",
      "implementations": {
        "clang": {
          "match": "tdesktop-orphaned-return-type",
          "inputs": "Clang written function type and name locations."
        }
      }
    },
    {
      "id": "declaration.pointer-nullptr-auto",
      "scope": "Explicitly typed pointer variables initialized with nullptr.",
      "exceptions": "Parameters, fields, already deduced variables, and macro locations.",
      "diagnostic": "Report the variable and recommend auto with a typed null pointer.",
      "fix": "Preserve the type with a cast when the declaration can be safely rewritten.",
      "implementations": {
        "clang": {
          "match": "tdesktop-pointer-nullptr-auto",
          "inputs": "Clang variable type, initializer kind, storage, and source tokens."
        }
      },
      "fix_kind": "source-rewrite"
    },
    {
      "id": "expression.assignment-continuation",
      "scope": "An initializer or assignment with = at the end of its left-hand line.",
      "exceptions": "Same-line assignments, an already leading =, and comments or directives between the operator and operand.",
      "diagnostic": "Report the = line when it or the first right-hand line changes.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Start the continuation with = and its right operand\\.",
          "inputs": "Tree-sitter node ranges, source bytes and staged lines.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "text.empty-marked",
      "scope": "Unqualified empty TextWithEntities temporaries written as () or {}.",
      "exceptions": "Type syntax, named object declarations, qualified names, and nonempty or commented argument lists.",
      "diagnostic": "Report the explicit empty temporary on a changed line.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Use tr::marked\\(\\) to create empty TextWithEntities\\.",
          "inputs": "Tree-sitter node ranges, source bytes and staged lines.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "class.local-method-definition",
      "scope": "Changed signatures of multiline member definitions in namespace-scoped classes in implementation files.",
      "exceptions": "Function-local classes, templates, one-line bodies and headers.",
      "diagnostic": "Define the method outside the class body.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Define the method outside the class body\\.",
          "inputs": "Tree-sitter nodes, source bytes and staged lines.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "initializer.entry-lines",
      "scope": "Multiline designated initializer lists and brace arguments to std::min or std::max.",
      "exceptions": "Single-line lists and other positional lists.",
      "diagnostic": "Put each entry of the multiline initializer on its own line.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Put each entry of the multiline initializer on its own line\\.",
          "inputs": "Tree-sitter nodes, source bytes and staged lines.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "initializer.ternary-closer-indent",
      "scope": "Multiline braced aggregates that open beside a leading ? or :.",
      "exceptions": "Inline branches and closing braces sharing a line with an entry.",
      "diagnostic": "Align the closing brace with the ternary branch marker.",
      "fix": "No automatic edit.",
      "implementations": {
        "python": {
          "match": "Align the closing brace with the ternary branch marker\\.",
          "inputs": "Tree-sitter nodes, source bytes and staged lines.",
          "modes": [
            "staged"
          ]
        }
      }
    },
    {
      "id": "include.block-order",
      "implementations": {
        "python": {
          "match": "Sort the include block with the Python formatter\\.",
          "modes": [
            "staged"
          ]
        }
      },
      "fix_kind": "source-rewrite"
    }
  ],
